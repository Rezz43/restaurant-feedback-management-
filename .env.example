# Where submitted feedback is POSTed as JSON. Leave empty to skip sending (demo mode).
VITE_FEEDBACK_ENDPOINT=
# Show the 10% off (MEGH10) thank-you card.
VITE_SHOW_INCENTIVE=true
# Ask for a private note to the manager when any rating is 2 or lower.
VITE_PRIVATE_NOTE=true
# Starting language: en or bn (guests can also open ?lang=bn).
VITE_START_LANG=en
